# Exemplo de uso. Crie o arquivo .env na raiz do projeto e coloque as informações de acordo com seu uso
# Host do banco de dados (Ex: localhost ou a URL do seu servidor)
DB_HOST=localost

# Porta do banco de dados (Padrão MySQL: 3306)
DB_PORT=3306

# Usuário do banco de dados
DB_USER=root

# Senha do banco de dados (Deixe vazio após o '=' se não houver senha)
DB_PASSWORD=

# Nome exato do banco de dados criado no MySQL
DB_DATABASE=seu_banco_de_dados

# Porta onde o servidor Node.js será executado (Ex: 3000)
PORT=3000